<Bindings>
	<!-- General layer, so these are live on the HUD rather than only inside a menu.

	     preventAutomaticInputModeChange mirrors the game's own START_CHAT_ENTER action. Without
	     it a key press coming from the keyboard flips the UI out of gamepad-preferred mode,
	     which on console swaps the entire interface. The stock chat bindings all set it.

	     START_CHAT is dead on console and is here for PC, where keyboard bindings work. The two
	     channel actions are the opposite case: keyboard keys never reach the binding system on
	     console, but GAMEPAD buttons do, so binding these to a controller button is how the
	     channel is walked without a key catcher up and without the buttons being paused. -->
	<Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
		<Category name="SI_KEYBINDINGS_CATEGORY_PBSCHATASSISTANT">
			<Action name="PBSCHATASSISTANT_START_CHAT" preventAutomaticInputModeChange="true">
				<Down>PBS_CHAT_ASSISTANT:StartChat()</Down>
			</Action>
			<Action name="PBSCHATASSISTANT_CHANNEL_NEXT" preventAutomaticInputModeChange="true">
				<Down>PBS_CHAT_ASSISTANT:CycleChannel(1)</Down>
			</Action>
			<Action name="PBSCHATASSISTANT_CHANNEL_PREV" preventAutomaticInputModeChange="true">
				<Down>PBS_CHAT_ASSISTANT:CycleChannel(-1)</Down>
			</Action>
		</Category>
	</Layer>
	<!-- Channel switching from the controller, live only while the chat entry is open.
	     
	     1.8.0 put a layer like this on the hud scene, so it shadowed L2 for the whole of play and
	     blocking stopped working. The button was not the mistake; the timing was. A layer pushed
	     only while the player is typing costs nothing, because nothing else on the pad is wanted
	     then: the entry binds UI_SHORTCUT_PRIMARY and UI_SHORTCUT_NEGATIVE and that is all, so L1
	     and R1 are free, and the chat system is already eating directional input so the player
	     cannot move either way.
	     
	     No chord needed at that point, so there is none. One button each way.
	     
	     allowFallthrough stays true. False means a layer blocks every action it does not declare,
	     which here would take submit and cancel with it.
	     
	     Pushed and popped from Lua, with a watchdog that removes it whenever the entry is not
	     open. A layer left pushed is exactly the 1.8.0 failure, so it is guarded rather than
	     trusted. -->
	<Layer name="PBsChatAssistantChatChannelLayer" allowFallthrough="true">
		<Category>
			<Action name="PBSCHATASSISTANT_ENTRY_CHANNEL_NEXT" inheritsBindFrom="UI_SHORTCUT_RIGHT_SHOULDER" hideAction="true" rebindable="false" preventAutomaticInputModeChange="true">
				<Down>PBS_CHAT_ASSISTANT:CycleChannel(1, true)</Down>
			</Action>
			<Action name="PBSCHATASSISTANT_ENTRY_CHANNEL_PREV" inheritsBindFrom="UI_SHORTCUT_LEFT_SHOULDER" hideAction="true" rebindable="false" preventAutomaticInputModeChange="true">
				<Down>PBS_CHAT_ASSISTANT:CycleChannel(-1, true)</Down>
			</Action>
		</Category>
	</Layer>
</Bindings>
