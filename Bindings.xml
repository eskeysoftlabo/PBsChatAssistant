<Bindings>
	<!-- General layer, so these are live on the HUD rather than only inside a menu.

	     preventAutomaticInputModeChange mirrors the game's own START_CHAT_ENTER action. Without
	     it a key press coming from the keyboard flips the UI out of gamepad-preferred mode,
	     which on console swaps the entire interface. The stock chat bindings all set it.

	     START_CHAT is dead on console and is here for PC, where keyboard bindings work. The two
	     channel actions are the opposite case: keyboard keys never reach the binding system on
	     console, but GAMEPAD buttons do, so binding these to a controller button is how the
	     channel is walked without a key catcher up and without the buttons being paused. -->
	<Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
		<Category name="SI_KEYBINDINGS_CATEGORY_PBSCHATASSISTANT">
			<Action name="PBSCHATASSISTANT_START_CHAT" preventAutomaticInputModeChange="true">
				<Down>PBS_CHAT_ASSISTANT:StartChat()</Down>
			</Action>
			<Action name="PBSCHATASSISTANT_CHANNEL_NEXT" preventAutomaticInputModeChange="true">
				<Down>PBS_CHAT_ASSISTANT:CycleChannel(1)</Down>
			</Action>
			<Action name="PBSCHATASSISTANT_CHANNEL_PREV" preventAutomaticInputModeChange="true">
				<Down>PBS_CHAT_ASSISTANT:CycleChannel(-1)</Down>
			</Action>
		</Category>
	</Layer>
	<!-- Channel switching from L2+L3, live only while the chat entry is open.
	     
	     1.8.0 put a layer like this on the hud scene, so it shadowed L2 for the whole of play and
	     blocking stopped working. The buttons were not the mistake; the timing was. A layer pushed
	     only while the player is typing costs nothing, because nothing else on the pad is wanted
	     then: the entry binds UI_SHORTCUT_PRIMARY and UI_SHORTCUT_NEGATIVE and that is all.
	     
	     Only L3 is declared here. L2 is never bound, anywhere: what the chord needs to know is
	     whether the trigger is pulled at the moment L3 goes down, and that is a question
	     GetGamepadLeftTriggerMagnitude answers on the spot. So there is no second action to
	     shadow L2 with, no chord state to latch, and no polling to notice a release that analogue
	     triggers do not report reliably. Each L3 press is decided on its own.
	     
	     allowFallthrough stays true. False means a layer blocks every action it does not declare,
	     which here would take submit and cancel with it.
	     
	     Pushed and popped from Lua, with a watchdog that removes it whenever the entry is not
	     open. A layer left pushed is exactly the 1.8.0 failure, so it is guarded rather than
	     trusted. -->
	<Layer name="PBsChatAssistantChatChannelLayer" allowFallthrough="true">
		<Category>
			<Action name="PBSCHATASSISTANT_ENTRY_CHANNEL_CHORD" inheritsBindFrom="UI_SHORTCUT_LEFT_STICK" hideAction="true" rebindable="false" preventAutomaticInputModeChange="true">
				<Down>PBS_CHAT_ASSISTANT:OnChannelChord()</Down>
			</Action>
			<!-- Diagnostic only, and it does nothing but write a log line.
			     
			     Everything measurable says the L3 action above should fire: registered, bound to
			     key 129, in a layer confirmed active and innermost, carried by a fragment. It does
			     not. So the question is whether this layer delivers anything at all, and L2 is the
			     one button known to be reachable from a layer of ours: shadowing it is what broke
			     blocking in 1.8.0.
			     
			     If L2 logs and L3 does not, the layer works and key 129 is being taken before UI
			     actions see it. If neither logs, the layer delivers nothing and the fault is
			     nearer home. Removed either way once it has answered. -->
			<Action name="PBSCHATASSISTANT_ENTRY_CHANNEL_PROBE" inheritsBindFrom="UI_SHORTCUT_LEFT_TRIGGER" hideAction="true" rebindable="false" preventAutomaticInputModeChange="true">
				<Down>PBS_CHAT_ASSISTANT:OnChannelProbe()</Down>
			</Action>
		</Category>
	</Layer>
</Bindings>
